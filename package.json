{
  "name": "pcloud_mcp",
  "version": "1.0.0",
  "description": "MCP server for pCloud API",
  "main": "dist/index.js",
  "bin": {
    "pcloud-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:http": "MODE=http bun run src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "MODE=http node dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "prepare": "bun run build"
  },
  "keywords": [
    "mcp",
    "pcloud",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "mcporter": "^0.7.3",
    "typescript": "^6.0.3"
  }
}
