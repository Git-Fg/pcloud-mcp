{
  "name": "pcloud-mcp",
  "version": "1.0.0",
  "description": "MCP server for pCloud: 37 typed tools over the pCloud HTTP/JSON API, stdio + HTTP transports, non-OAuth static access token.",
  "main": "dist/index.js",
  "private": true,
  "bin": {
    "pcloud-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:http": "MODE=http bun run src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "MODE=http node dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "prepare": "bun run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:e2e": "bun run scripts/live-mcp-e2e.ts"
  },
  "keywords": [
    "mcp",
    "pcloud",
    "model-context-protocol"
  ],
  "author": "Felix",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Git-Fg/pcloud-mcp.git"
  },
  "homepage": "https://github.com/Git-Fg/pcloud-mcp#readme",
  "bugs": {
    "url": "https://github.com/Git-Fg/pcloud-mcp/issues"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "mcporter": "^0.7.3",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist",
    "generated",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ]
}
